@model ResultGetAboutByIDDto
@{
    ViewData["Title"] = "UpdateAbout";
    Layout = "~/Areas/Admin/Views/AdminLayout/_AdminLayout.cshtml";
}


<div class="row">
    <div class="col-xl-12 mx-auto">
        <h6 class="mb-0 text-uppercase">Hakkımızda İşlemleri</h6>
        <hr />
        <div class="card">
            <div class="card-body">
                <form method="post">

                    <input type="hidden" asp-for="AboutID" />

                    <input type="text" asp-for="Title" class="form-control" placeholder="Kategor Adını Giriniz" />
                    <br />
                    <textarea rows="5" class="form-control mb-3" asp-for="Description" placeholder="Açıklama" aria-label="Açıklama"> </textarea>
                    <br />
                    <select asp-for="Status" class="form-control">
                        <option value="">--- Lütfen Seniniz ---</option>
                        <option value="true">Aktif</option>
                        <option value="false">Pasif</option>
                    </select>
                    <br />
                    <button class="btn btn-primary">Kaydet</button>

                </form>
            </div>
        </div>
    </div>
</div>
