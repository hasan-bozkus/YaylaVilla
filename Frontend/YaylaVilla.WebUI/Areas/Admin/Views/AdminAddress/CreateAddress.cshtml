@model CreateAddressDto
@{
    ViewData["Title"] = "CreateAddress";
    Layout = "~/Areas/Admin/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-xl-12 mx-auto">
        <h6 class="mb-0 text-uppercase">Adres İşlemleri</h6>
        <hr />
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <input class="form-control mb-3" asp-for="MapLocation" type="text" placeholder="Harita" aria-label="Harita">
                    <br />
                    <input class="form-control mb-3" asp-for="StreetAddress" type="text" placeholder="Açık Adres" aria-label="Adres">
                    <br />
                    <input class="form-control mb-3" asp-for="PhoneNumber" type="text" placeholder="Telefon" aria-label="Telefon">
                    <br />
                    <input class="form-control mb-3" asp-for="Email" type="text" placeholder="E-Posta" aria-label="E-Posta">
                    <br />
                    <textarea rows="5" class="form-control mb-3" asp-for="Description" placeholder="Açıklama" aria-label="Açıklama"> </textarea>
                    <br />

                    <button class="btn btn-primary">Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>

