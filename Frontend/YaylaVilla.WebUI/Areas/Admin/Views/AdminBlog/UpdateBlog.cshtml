@model ResultGetBlogByIDDto
@{
    ViewData["Title"] = "UpdateBlog";
    Layout = "~/Areas/Admin/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-xl-12 mx-auto">
        <h6 class="mb-0 text-uppercase">Blog İşlemleri</h6>
        <hr />
        <div class="card">
            <div class="card-body">
                <form method="post">

                    <input type="hidden" asp-for="BlogID" />
                    <input type="hidden" asp-for="CreatedDate" />

                    <input class="form-control mb-3" asp-for="Title" type="text" placeholder="Başlık" aria-label="Başlık">
                    <br />

                    <input class="form-control mb-3" asp-for="ImageUrl" type="text" placeholder="Görsel Url" aria-label="Görsel Url">
                    <br />

                    <textarea rows="5" class="form-control mb-3" asp-for="Content" placeholder="İçerik" aria-label="İçerik"> </textarea>
                    <br />

                    <button class="btn btn-primary">Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>
