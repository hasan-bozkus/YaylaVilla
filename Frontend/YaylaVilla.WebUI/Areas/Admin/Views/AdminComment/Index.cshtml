@model List<ResultCommentDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/_AdminLayout.cshtml";
    int count = 0;
}

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />
    <style>
        /* ── Kart ── */
        .dt-wrapper-card {
            background: #fff;
            border: 1px solid #e8eaf0;
            border-radius: 16px;
            box-shadow: 0 2px 20px rgba(67,56,202,.07);
            overflow: hidden;
        }

        .dt-wrapper-card .card-header-custom {
            padding: 18px 24px;
            border-bottom: 1px solid #f0f1f8;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }

        .dt-section-label {
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: #4338ca;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .dt-section-label::before {
            content: '';
            width: 7px; height: 7px;
            border-radius: 50%;
            background: #4338ca;
        }

        .badge-count {
            background: #ede9fe;
            color: #4338ca;
            border: 1px solid #c4b5fd;
            border-radius: 20px;
            padding: 3px 12px;
            font-size: .74rem;
            font-weight: 700;
        }

        /* ── DataTables overrides ── */
        .dataTables_wrapper {
            padding: 20px 24px;
            font-family: inherit;
        }

        .dataTables_wrapper .dataTables_filter label,
        .dataTables_wrapper .dataTables_length label {
            font-size: .8rem;
            color: #6b7280;
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 500;
        }

        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #e5e7eb !important;
            border-radius: 9px !important;
            padding: 7px 13px !important;
            font-size: .82rem !important;
            color: #1f2937 !important;
            background: #fafafa !important;
            transition: border-color .2s, box-shadow .2s !important;
            width: 210px !important;
        }

        .dataTables_wrapper .dataTables_filter input:focus {
            border-color: #4338ca !important;
            box-shadow: 0 0 0 3px rgba(67,56,202,.1) !important;
            outline: none !important;
            background: #fff !important;
        }

        .dataTables_wrapper .dataTables_length select {
            border: 1px solid #e5e7eb !important;
            border-radius: 8px !important;
            padding: 6px 10px !important;
            font-size: .8rem !important;
            color: #374151 !important;
            background: #fafafa !important;
        }

        /* ── Tablo ── */
        table.dataTable {
            border-collapse: separate !important;
            border-spacing: 0 !important;
            margin: 14px 0 !important;
        }

        table.dataTable thead th {
            background: #f8f9fc !important;
            color: #6b7280 !important;
            font-size: .69rem !important;
            font-weight: 700 !important;
            text-transform: uppercase !important;
            letter-spacing: 1.2px !important;
            padding: 13px 16px !important;
            border-bottom: 2px solid #eff0f6 !important;
            border-top: none !important;
            white-space: nowrap;
        }

        table.dataTable thead th.sorting_asc,
        table.dataTable thead th.sorting_desc {
            color: #4338ca !important;
            background: rgba(67,56,202,.04) !important;
        }

        table.dataTable tbody tr { transition: background .12s; }

        table.dataTable tbody tr:hover td {
            background: #fafaff !important;
        }

        table.dataTable tbody td {
            padding: 13px 16px !important;
            border-top: 1px solid #f1f2f6 !important;
            border-bottom: none !important;
            font-size: .85rem !important;
            color: #374151;
            vertical-align: middle;
        }

        table.dataTable.stripe tbody tr.odd td {
            background: #fafbff !important;
        }

        /* ── # sütunu rozeti ── */
        .row-num {
            width: 30px; height: 30px;
            background: #ede9fe;
            color: #4338ca;
            border: 1px solid #c4b5fd;
            border-radius: 7px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .74rem;
            font-weight: 700;
        }

        /* ── Yorum adı ── */
        .cat-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cat-icon {
            width: 34px; height: 34px;
            border-radius: 9px;
            background: linear-gradient(135deg,#ede9fe,#ddd6fe);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .85rem;
            flex-shrink: 0;
        }

        .cat-name {
            font-weight: 600;
            font-size: .88rem;
            color: #1f2937;
        }

        /* ── Aksiyon butonları ── */
        .btn-tbl {
            border-radius: 8px;
            padding: 5px 13px;
            font-size: .75rem;
            font-weight: 600;
            border: 1.5px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: all .15s;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-tbl:hover { transform: translateY(-1px); }

        .btn-tbl-danger  { background:rgba(220,38,38,.08);  color:#dc2626; border-color:rgba(220,38,38,.2); }
        .btn-tbl-warning { background:rgba(217,119,6,.08);  color:#d97706; border-color:rgba(217,119,6,.2); }
        .btn-tbl-success { background:rgba(5,150,105,.08);  color:#059669; border-color:rgba(5,150,105,.2); }

        .btn-tbl-danger:hover  { background:#dc2626; color:#fff; box-shadow:0 4px 12px rgba(220,38,38,.28); }
        .btn-tbl-warning:hover { background:#d97706; color:#fff; box-shadow:0 4px 12px rgba(217,119,6,.28); }
        .btn-tbl-success:hover { background:#059669; color:#fff; box-shadow:0 4px 12px rgba(5,150,105,.28); }

        /* ── tfoot ── */
        table.dataTable tfoot th {
            background: #f8f9fc !important;
            color: #9ca3af !important;
            font-size: .68rem !important;
            font-weight: 700 !important;
            text-transform: uppercase !important;
            letter-spacing: 1.2px !important;
            padding: 11px 16px !important;
            border-top: 2px solid #eff0f6 !important;
            border-bottom: none !important;
        }

        /* ── Info & Pagination ── */
        .dataTables_info {
            font-size: .78rem !important;
            color: #9ca3af !important;
            padding-top: 10px !important;
        }

        .dataTables_paginate { padding-top: 6px !important; }

        .dataTables_paginate .pagination {
            justify-content: flex-end;
            gap: 3px;
            flex-wrap: wrap;
        }

        .dataTables_paginate .page-item .page-link {
            background: #fff !important;
            border: 1px solid #e5e7eb !important;
            color: #6b7280 !important;
            border-radius: 8px !important;
            font-size: .78rem !important;
            font-weight: 600 !important;
            padding: 7px 12px !important;
            transition: all .15s !important;
            font-family: inherit !important;
        }

        .dataTables_paginate .page-item:not(.disabled):not(.active) .page-link:hover {
            background: #ede9fe !important;
            border-color: #c4b5fd !important;
            color: #4338ca !important;
        }

        .dataTables_paginate .page-item.active .page-link {
            background: #4338ca !important;
            border-color: #4338ca !important;
            color: #fff !important;
            box-shadow: 0 3px 10px rgba(67,56,202,.3) !important;
        }

        .dataTables_paginate .page-item.disabled .page-link { opacity:.4 !important; }

        /* ── Dışa Aktarma Butonları ── */
        .dt-buttons { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:2px; }

        .dt-button {
            background: #fff !important;
            border: 1px solid #e5e7eb !important;
            color: #6b7280 !important;
            border-radius: 8px !important;
            padding: 7px 13px !important;
            font-size: .76rem !important;
            font-weight: 600 !important;
            font-family: inherit !important;
            transition: all .15s !important;
            box-shadow: none !important;
            cursor: pointer;
        }

        .dt-button:hover {
            background: #ede9fe !important;
            border-color: #c4b5fd !important;
            color: #4338ca !important;
        }

        /* ── Boş durum ── */
        .empty-state {
            text-align: center;
            padding: 56px 20px;
            color: #9ca3af;
        }

        .empty-state-icon { font-size:2.5rem; margin-bottom:12px; opacity:.45; }
        .empty-state p { font-size:.9rem; font-weight:500; }

        /* ── Sayfa başlığı ── */
        .page-top {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 22px;
        }

        .page-top h5 {
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: -.3px;
            color: #1e1b4b;
            margin: 0;
        }

        .page-top small {
            display: block;
            font-size: .78rem;
            color: #9ca3af;
            margin-top: 3px;
        }

        .btn-yeni {
            background: #4338ca;
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 9px 18px;
            font-size: .82rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            box-shadow: 0 4px 14px rgba(67,56,202,.25);
            transition: background .2s, transform .15s, box-shadow .2s;
        }

        .btn-yeni:hover {
            background: #3730a3;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(67,56,202,.32);
        }
    </style>

<!-- Sayfa Başlığı -->
<div class="page-top">
    <div>
        <h5>Yorum Yönetimi</h5>
        <small>Tüm yorumları görüntüleyin, düzenleyin ve yönetin</small>
    </div>
    <a asp-area="Admin" asp-controller="AdminComment" asp-action="CreateComment" class="btn-yeni">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        Yeni Yorum
    </a>
</div>

<!-- Kart -->
<div class="dt-wrapper-card">

    <div class="card-header-custom">
        <span class="dt-section-label">Yorumlar</span>
        <span class="badge-count">@Model.Count kayıt</span>
    </div>

    <div class="table-responsive">

        @if (Model != null && Model.Any())
        {
            <table id="categoryTable" class="table table-striped table-bordered" style="width:100%">
                <thead>
                    <tr>
                        <th style="width:60px">#</th>
                        <th>Yorum Yapan</th>
                        <th>Yorum Tarihi</th>
                        <th style="width:90px;  text-align:center">Sil</th>
                        <th style="width:115px; text-align:center">Düzenle</th>
                        <th style="width:155px; text-align:center">Yazıyı Görüntüle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <td>
                                <span class="row-num">@count</span>
                            </td>
                            <td>
                                <div class="cat-cell">
                                    <div class="cat-icon">🏷️</div>
                                    <span class="cat-name">@item.Name @item.Surname</span>
                                </div>
                            </td>
                            <td>
                                <div class="cat-cell">
                                    <div class="cat-icon">🏷️</div>
                                    <span class="cat-name">@item.CreatedDate.ToShortDateString() </span>
                                </div>
                            </td>
                            <td style="text-align:center">
                                <a asp-area="Admin"
                                   asp-controller="AdminComment"
                                   asp-action="DeleteComment"
                                   asp-route-id="@item.CommentID"
                                   class="btn-tbl btn-tbl-danger"
                                   onclick="return confirm('@item.CommentID değerini silmek istediğinizden emin misiniz?')">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" />
                                        <path d="M10 11v6M14 11v6" />
                                        <path d="M9 6V4h6v2" />
                                    </svg>
                                    Sil
                                </a>
                            </td>
                            <td style="text-align:center">
                                <a asp-area="Admin"
                                   asp-controller="AdminComment"
                                   asp-action="UpdateComment"
                                   asp-route-id="@item.CommentID"
                                   class="btn-tbl btn-tbl-warning">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" />
                                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
                                    </svg>
                                    Düzenle
                                </a>
                            </td>
                            <td style="text-align:center">
                                <a asp-area="Admin"
                                   asp-controller="AdminComment"
                                   asp-action="GetComment"
                                   asp-route-id="@item.CommentID"
                                   class="btn-tbl btn-tbl-success">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                    Yorumu Gör
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th style="width:60px">#</th>
                        <th>Yorum Yapan</th>
                        <th>Yorum Tarihi</th>
                        <th style="width:90px;  text-align:center">Sil</th>
                        <th style="width:115px; text-align:center">Düzenle</th>
                        <th style="width:155px; text-align:center">Yazıyı Görüntüle</th>
                    </tr>
                </tfoot>
            </table>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">📂</div>
                <p>Henüz hiç yorum eklenmemiş.</p>
                <a asp-area="Admin" asp-controller="AdminComment" asp-action="CreateComment"
                   class="btn-yeni" style="margin-top:14px;display:inline-flex">
                    İlk yorum Oluştur
                </a>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

    <script>
        $(function () {
            "use strict";

            var table = $('#categoryTable').DataTable({
                lengthChange: false,
                pageLength: 10,
                language: {
                    search:            "Ara:",
                    searchPlaceholder: "Yorum ara...",
                    zeroRecords:       "Eşleşen kayıt bulunamadı",
                    emptyTable:        "Tabloda veri yok",
                    info:              "_TOTAL_ kayıttan _START_–_END_ arası gösteriliyor",
                    infoEmpty:         "Kayıt yok",
                    infoFiltered:      "(toplam _MAX_ kayıt içinden filtrelendi)",
                    paginate: {
                        first:    "İlk",
                        last:     "Son",
                        next:     "Sonraki",
                        previous: "Önceki"
                    },
                    lengthMenu: "_MENU_ kayıt göster",
                    processing: "Yükleniyor..."
                },
                buttons: [
                    { extend: 'copy',  text: '📋 Kopyala', className: 'dt-button' },
                    { extend: 'excel', text: '📊 Excel',   className: 'dt-button' },
                    { extend: 'pdf',   text: '📄 PDF',     className: 'dt-button' },
                    { extend: 'print', text: '🖨️ Yazdır',  className: 'dt-button' }
                ],
                columnDefs: [
                    { orderable: false, targets: [2, 3, 4] }
                ]
            });

            table.buttons().container()
                .appendTo('#categoryTable_wrapper .col-md-6:eq(0)');
        });
    </script>
}

