@model ResultGetContactByIDDto
@{
    ViewData["Title"] = "GetContact";
    Layout = "~/Areas/Admin/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-xl-12 mx-auto">
        <h6 class="mb-0 text-uppercase">Kategori İşlemleri</h6>
        <hr />
        <div class="card">
            <div class="card-body">
                <form method="post">

                    <input type="hidden" asp-for="ContactID" />

                    <input type="text" asp-for="Name" class="form-control" />
                    <br />

                    <input type="text" asp-for="Surname" class="form-control" />
                    <br />

                    <input type="text" asp-for="Email" class="form-control" />
                    <br />

                    <input type="text" asp-for="Subject" class="form-control" />
                    <br />

                    <textarea type="text" asp-for="Message" class="form-control"> </textarea>
                    <br />
                    <button class="btn btn-primary">Kaydet</button>

                </form>
            </div>
        </div>
    </div>
</div>
