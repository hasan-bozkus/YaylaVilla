@using X.PagedList
@using X.PagedList.Mvc.Core
@using X.PagedList.Web.Common
@model PagedList<ResultBlogDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<section class="ftco-section">
    <div class="container">
        <div class="row d-flex">
            @foreach(var item in Model)
            {
                <div class="col-md-3 d-flex ftco-animate">
                    <div class="blog-entry justify-content-end">
                        <div class="text">
                            <h3 class="heading"><a href="#">@item.Title</a></h3>
                            <div class="meta mb-3">
                                <div><a href="#"> @item.CreatedDate.ToString("MMM. dd, yyyy") July. 24, 2019</a></div>
                                <div><a href="#" class="meta-chat"><span class="icon-chat"></span> 3</a></div>
                            </div>
                            <a href="blog-single.html" class="block-20 img" style="background-image: url('@item.ImageUrl');">
                            </a>
                            <p>@Html.Raw(item.Content)</p>
                        </div>
                    </div>
                </div>
            }

            
        </div>
        <div class="row mt-5">
            <div class="col text-center">
                <div class="block-27">
                    @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page }),
                         new PagedListRenderOptions
                         {
                             LinkToFirstPageFormat = "<a href=\"#\">&lt;</a></li>",
                             LinkToLastPageFormat = "<a href=\"#\">&gt;</a></li>",
                             LinkToNextPageFormat = ">",
                             LinkToPreviousPageFormat = "<",
                             ContainerDivClasses = new[] { "block-27" },
                             UlElementClasses = new[] { " " },
                             LiElementClasses = new[] { " " },
                             ActiveLiElementClass = "active",
                         })
                </div>
            </div>
        </div>
    </div>
</section>
