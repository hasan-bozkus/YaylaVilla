@using X.PagedList
@using X.PagedList.Mvc.Core 
@using X.PagedList.Web.Common
@model PagedList<ResultProductDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}
<section class="ftco-section">
    <div class="container">
        <div class="row">

            @foreach(var item in Model)
            {
                <div class="col-md-4">
                    <div class="property-wrap ftco-animate">
                        <a href="properties-single.html" class="img" style="background-image: url(@item.ImageUrl);"></a>
                        <div class="text">
                            <p class="price"><span class="old-price">800,000</span><span class="orig-price">@item.PropertyPrice.ToString("N2")@*<small>/mo</small>*@</span></p>
                            <ul class="property_list">
                                <li><span class="flaticon-bed"></span>@item.BedRoomCount</li>
                                <li><span class="flaticon-bathtub"></span>@item.BathRoomCount</li>
                                <li><span class="flaticon-floor-plan"></span>@item.AreaSquareMeter metrekare</li>
                            </ul>
                            <h3><a href="properties-single.html">@item.Title</a></h3>
                            <span class="location">@item.District / @item.City</span>
                            <a href="/#/@item.ProductID" class="d-flex align-items-center justify-content-center btn-custom">
                                <span class="ion-ios-link"></span>
                            </a>
                        </div>
                    </div>
                </div>
            }          
            
        </div>
        <div class="row mt-5">
            <div class="col text-center">
                <div class="block-27">
@Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page }), 
                        new PagedListRenderOptions
                        {
                                                LinkToFirstPageFormat = "<a href=\"#\">&lt;</a></li>",
                                                LinkToLastPageFormat = "<a href=\"#\">&gt;</a></li>",
                                                LinkToNextPageFormat = ">",
                                                LinkToPreviousPageFormat = "<",
                                                ContainerDivClasses = new[] { "block-27" },
                                                UlElementClasses = new[] { " " },
                                                LiElementClasses = new[] { " " },
                                                ActiveLiElementClass = "active",
                                    })
                </div>
            </div>
        </div>
    </div>
</section>