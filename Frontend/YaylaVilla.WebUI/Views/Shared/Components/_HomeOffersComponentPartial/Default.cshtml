@model List<ResultGetSpecialOfferListDto>

<section class="ftco-section goto-here">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12 heading-section text-center ftco-animate mb-5">
                <span class="subheading">Özel Tekliflerimiz</span>
                <h2 class="mb-2">Sizin İçin Önerilenler</h2>
            </div>
        </div>
        <div class="row">
            
            @foreach(var item in Model)
            {
                <div class="col-md-4">
                    <div class="property-wrap ftco-animate">
                        <a href="#" class="img" style="background-image: url(@item.ImageUrl);"></a>
                        <div class="text">
                            <p class="price"><span class="old-price">800,000</span><span class="orig-price">₺ @item.PropertyPrice.ToString("C")<small>/Aylık</small></span></p>
                            <ul class="property_list">
                                <li><span class="flaticon-bed"></span>@item.BedRoomCount</li>
                                <li><span class="flaticon-bathtub"></span>@item.BathRoomCount</li>
                                <li><span class="flaticon-floor-plan"></span>@item.AreaSquareMeter metrekare</li>
                            </ul>
                            <h3><a href="#">@item.Title</a></h3>
                            <span class="location">@item.District / @item.City</span>
                            <a href="#" class="d-flex align-items-center justify-content-center btn-custom">
                                <span class="ion-ios-link"></span>
                            </a>
                        </div>
                    </div>
                </div>

            }
            
        </div>
    </div>
</section>
