@model List<ResultGetLast4BlogListDto>


<section class="ftco-section ftco-no-pt">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 heading-section text-center ftco-animate">
                <span class="subheading">Bloglar</span>
                <h2>Sabitlenmiş Bloglar</h2>
            </div>
        </div>
        <div class="row d-flex">
            @foreach(var item in Model)
            {
                <div class="col-md-3 d-flex ftco-animate">
                    <div class="blog-entry justify-content-end">
                        <div class="text">
                            <h3 class="heading"><a href="#">@item.Title</a></h3>
                            <div class="meta mb-3">
                                <div><a href="#">@item.CreatedDate.ToString("MMM, dd-yyyy")</a></div>
@*                                 <div><a href="#">Admin</a></div>
 *@                                <div><a href="#" class="meta-chat"><span class="icon-chat"></span> 3</a></div>
                            </div>
                            <a href="blog-single.html" class="block-20 img" style="background-image: url('/uptown-master/images/image_1.jpg');">
                            </a>
                            <p>@item.Content</p>
                        </div>
                    </div>
                </div>
                
            }           
        </div>
    </div>
</section>