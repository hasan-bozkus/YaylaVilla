@model List<ResultServiceDto>

<section class="ftco-section ftco-no-pb">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12 heading-section text-center ftco-animate mb-5">
                <span class="subheading">Hizmetlerimiz</span>
                <h2 class="mb-2">The smartest way to buy a home</h2>
            </div>
        </div>
        <div class="row d-flex">
            @foreach(var item in Model)
            {
                <div class="col-md-3 d-flex align-self-stretch ftco-animate">
                    <div class="media block-6 services d-block text-center">
                        <div class="icon d-flex justify-content-center align-items-center"><span class="@item.Icon"></span></div>
                        <div class="media-body py-md-4">
                            <h3>@item.Title</h3>
                            <p>@item.Content</p>
                        </div>
                    </div>
                </div>
            }           
        </div>
    </div>
</section>
