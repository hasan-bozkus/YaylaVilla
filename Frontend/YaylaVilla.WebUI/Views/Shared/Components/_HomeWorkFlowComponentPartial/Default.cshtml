@model List<ResultWorkFlowDto>

@{
    int count = 0;
}

<section class="ftco-section ftco-degree-bg services-section img mx-md-5" style="background-image: url(/uptown-master/images/bg_2.jpg);">
    <div class="overlay"></div>
    <div class="container">
        <div class="row justify-content-start mb-5">
            <div class="col-md-6 text-center heading-section heading-section-white ftco-animate">
                <span class="subheading">Çalışma Akışı</span>
                <h2 class="mb-3">Nasıl Çalışır?</h2>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="row">
                    @foreach(var item in Model)
                    {
                        count++;

                        <div class="col-md-12 col-lg-6 d-flex align-self-stretch ftco-animate">
                            <div class="media block-6 services services-2">
                                <div class="media-body py-md-4 text-center">
                                    <div class="icon mb-3 d-flex align-items-center justify-content-center"><span>@count.ToString("D2")</span></div>
                                    <h3>@item.Title</h3>
                                    <p>@item.Content</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
